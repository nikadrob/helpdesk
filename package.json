{
  "name": "helpdesk",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:client": "bun --filter client dev",
    "dev:server": "bun --filter server dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "bun --filter server db:migrate",
    "db:generate": "bun --filter server db:generate",
    "db:studio": "bun --filter server db:studio",
    "db:seed": "bun --filter server db:seed"
  }
}
